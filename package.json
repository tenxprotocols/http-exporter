{
  "name": "@tenxprotocols/http-exporter",
  "version": "5.0.1",
  "description": "A flexible OpenMetrics exporter for HTTP (RPC and REST) endpoints",
  "main": "dist/index.js",
  "bin": {
    "http-exporter": "dist/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tenxprotocols/http-exporter"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc",
    "prepublishOnly": "tsc",
    "test": "NODE_NO_WARNINGS=1 jest",
    "docker:build": "docker build -t tenx-http-exporter .",
    "docker:run": "docker run --rm -p 3000:3000 -v ./config.example.yaml:/usr/src/app/config.yaml tenx-http-exporter"
  },
  "keywords": [],
  "author": "",
  "license": "BUSL",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@koa/router": "^15.2.0",
    "axios": "^1.13.2",
    "js-yaml": "^4.1.1",
    "koa": "^3.1.1",
    "lodash": "^4.17.21",
    "pino": "^10.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^3.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/lodash": "^4.17.13",
    "@types/node": "^25.0.3",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
